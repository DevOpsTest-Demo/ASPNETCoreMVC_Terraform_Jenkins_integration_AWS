<Project>
  <ItemGroup>
    <StaticWebAsset Include="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\staticwebassets\Sample.png'))">
      <SourceType>Package</SourceType>
      <SourceId>FirstCoreMVCAPP</SourceId>
      <ContentRoot>$(MSBuildThisFileDirectory)..\staticwebassets\</ContentRoot>
      <BasePath>_content/FirstCoreMVCAPP</BasePath>
      <RelativePath>Sample.png</RelativePath>
      <AssetKind>All</AssetKind>
      <AssetMode>All</AssetMode>
      <AssetRole>Primary</AssetRole>
      <RelatedAsset></RelatedAsset>
      <AssetTraitName></AssetTraitName>
      <AssetTraitValue></AssetTraitValue>
      <Fingerprint>szwqxqcthr</Fingerprint>
      <Integrity>eG07F9/b8CrzeBKnd7oehqdbSXBtANMw1bZPR9y2LMA=</Integrity>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <OriginalItemSpec>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\staticwebassets\Sample.png'))</OriginalItemSpec>
    </StaticWebAsset>
  </ItemGroup>
</Project>